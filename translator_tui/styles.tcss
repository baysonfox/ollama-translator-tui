Screen {
    layout: vertical;
}

#root {
    margin: 1;
    padding: 1;
    border: round $primary;
    height: 1fr;
}

#panes {
    height: 1fr;
    width: 100%;
}

.pane {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

.pane_title {
    content-align: center middle;
    width: 100%;
    margin-bottom: 1;
    text-style: bold;
}

TextArea {
    width: 100%;
    height: 1fr;
    border: round $surface;
}

#controls {
    margin-top: 1;
    align: center middle;
    height: auto;
}

#source_language,
#target_language {
    width: 28;
    margin: 0 2;
}

#translate_button {
    width: 18;
}
